# Model Source & Cache
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=0
MODELSCOPE_CACHE=./model_cache/modelscope
HF_HOME=./model_cache/huggingface
MINERU_TIMEOUT_SECONDS=600
TEMP_DATA_DIR=./temp_data

# LLM API (SiliconFlow / OpenAI compatible)
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_DEFAULT_MODEL=zai-org/GLM-5.2
MODEL=zai-org/GLM-5.2
ITEM_MODEL=zai-org/GLM-5.2
VL_MODEL=Qwen/Qwen3-VL-32B-Instruct
LLM_DEFAULT_TEMPERATURE=0.1

# BGE models
BGE_M3_PATH=./model_cache/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=./model_cache/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# Embedding
EMBEDDING_DIM=1024
EMBEDDING_MODEL=text-embedding-v4

# Milvus
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
ENTITY_NAME_COLLECTION=kb_entity_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.6

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb001
MONGO_USER=
MONGO_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base
MINIO_SECURE=False

# Query tuning
MAX_CONTEXT_CHARS=6000
RERANK_MAX_TOP_K=5
RERANK_MIN_TOP_K=2
RERANK_GAP_RATIO=0.25
RERANK_GAP_ABS=0.5
RRF_K=60
RRF_MAX_RESULTS=5
EMBEDDING_SEARCH_LIMIT=5
HYDE_SEARCH_LIMIT=3
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.7
ITEM_NAME_MAX_OPTIONS=5
ITEM_NAME_DENSE_WEIGHT=0.5
ITEM_NAME_SPARSE_WEIGHT=0.5
QUERY_CACHE_TTL_SECONDS=300
QUERY_CACHE_MAX_ITEMS=200

# Logging (loguru)
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

# MCP web search (optional)
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_DASHSCOPE_API_KEY=sk-your-dashscope-key

# API auth & CORS
# 生产部署时必须设置 APP_API_KEY，留空则跳过鉴权（仅限本地开发）
APP_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001

# Docker: host path to model weights (BGE-M3, BGE-Reranker)
MODEL_HOST_PATH=./model_cache/models