# ============================================================
# 生产环境变量 — 不入 git，部署时手动放置于项目根目录
# 所有 <...> 占位符需替换为实际值
# ============================================================

# ---- 认证 ----
APP_API_KEY=<生成32位随机字符串>
APP_ADMIN_ENABLE=true

# ---- 域名与 CORS ----
MINIO_PUBLIC_BASE_URL=https://img.xxx.com
ALLOWED_ORIGINS=https://qa.xxx.com,https://import.xxx.com

# ---- 中间件连接 ----
MILVUS_URL=http://milvus:19530
MONGO_URL=mongodb://zhihui_user:<业务密码>@mongo:27017/kb001
MONGO_DB_NAME=kb001
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=<root密码>

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<替换为非默认值>
MINIO_SECRET_KEY=<替换为非默认值>
MINIO_BUCKET_NAME=knowledge-base
MINIO_SECURE=False

# ---- LLM API (SiliconFlow) ----
OPENAI_API_KEY=<替换为生产 API Key>
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_DEFAULT_MODEL=zai-org/GLM-5.2
MODEL=zai-org/GLM-5.2
ITEM_MODEL=zai-org/GLM-5.2
VL_MODEL=Qwen/Qwen3-VL-32B-Instruct
LLM_DEFAULT_TEMPERATURE=0.1

# ---- BGE 模型 (本地 CPU) ----
BGE_M3_PATH=/models/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False
BGE_RERANKER_LARGE=/models/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=False

# ---- Embedding ----
EMBEDDING_DIM=1024

# ---- MinerU (生产 VPS 首版不承担 PDF；AutoDL 设 MINERU_BIN=mineru) ----
MINERU_BIN=mineru
MINERU_TIMEOUT_SECONDS=600
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=0
MODELSCOPE_CACHE=/app/model_cache/modelscope
HF_HOME=/app/model_cache/huggingface

# ---- 路径 ----
TEMP_DATA_DIR=/app/temp_data
MODEL_HOST_PATH=/data/models

# ---- Milvus 集合 ----
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
ENTITY_NAME_COLLECTION=kb_entity_names
MILVUS_METRIC_TYPE=COSINE

# ---- 查询调优 ----
MILVUS_MIN_COSINE_SCORE=0.6
MAX_CONTEXT_CHARS=6000
RERANK_MAX_TOP_K=5
RERANK_MIN_TOP_K=2
RRF_K=60
EMBEDDING_SEARCH_LIMIT=5
HYDE_SEARCH_LIMIT=3
ITEM_NAME_HIGH_CONFIDENCE=0.7
ITEM_NAME_MID_CONFIDENCE=0.7
QUERY_CACHE_TTL_SECONDS=300

# ---- MCP Web Search ----
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
MCP_DASHSCOPE_API_KEY=<百炼 API Key>

# ---- 日志 ----
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days
